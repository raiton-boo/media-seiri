{
  "name": "file-seiri",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "seiri": "bun packages/cli/src/main.ts",
    "check": "biome check .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test packages --parallel",
    "build:binary": "bun scripts/build-binary.ts",
    "build:viewers": "bun scripts/build-viewers.ts",
    "test:serial": "bun test packages",
    "test:changed": "bun test packages --parallel --changed"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
